@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap");
:root {
  /* Action Blue & Tonal Range */
  --color-primary: #003d9b;
  --color-primary-container: #0052cc;
  --color-surface-highest: #d7e2ff;
  --color-surface-low: #f1f3ff;
  --color-background: #f9f9ff;
  --color-white: #ffffff;

  /* Slate Neutrals */
  --color-slate-dark: #041b3c;
  --color-slate-medium: #4f5f7b;
  --color-slate-light: #c3c6d6;

  /* Semantic */
  --color-success: #82f9be;
  --color-error: #ba1a1a;
  --color-warning: #ffb300;

  /* Other Colors */
  --color-text-body: #434654;
  --color-placeholder: #737685;
  --color-error-msg-bg: #ffdad6;
  --color-error-msg-text: #93000a;
  --color-active-task-label: #002113;
  --color-icon-card: #e8edff;
  --color-third-heading: #041b3c;

  /* Border Radius */
  --rounded-2xs: 2px;
  --rounded-xs: 4px;
  --rounded-sm: 8px;
  --rounded-md: 12px;
  --rounded-md: 16px;
  --rounded-full: 9999px;

  --font-base: 1rem;   /*16 px */
  --font-sm: 0.625rem; /* 10px */
  --font-lg: 1.125rem; /* 18px */
  --font-xs: 0.687rem; /* 11px  */
  --font-title: 1.125rem; /* 18px */
  --font-xl: 1.875rem; /* 30px */
  --font-weekly-title: 1.875rem; 
 


  --primary-gradient: linear-gradient(135deg, #003D9B 0%, #0052CC 100%);

 /*  ====================  Epic & Assignee Theme  ====================  */

  --epic-green-light: #82F9BE;
  --epic-green-dark: #65DCA4;

  /* Typography */
  --font-sans: "Inter", sans-serif;
}

body {
  font-family: var(--font-sans);
  background-color: var(--color-background);
}

/* ==================== UTILITIES ==================== */


.description-box {
  font-size: .875; /* 14px  */
}

/* Input fields matching Figma */
.input-text {
  display: block;
  background-color: var(--color-surface-highest);
  padding: 1rem 1.125rem;
  color: var(--color-slate-dark);
  width: 100%;
  font-weight: 400;
  font-size: 14px;
  border-radius: var(--rounded-sm);
  border: 1px solid transparent;
  outline: none;
  transition: all 0.2s ease;
}
.input-text:focus {
  background-color: var(--color-white);
  border-color: var(--color-primary-container);
}

/* Form labels */
.form-label {
  font-size: 11px;
  line-height: 16.5px;
  letter-spacing: 0.55px;
  text-transform: uppercase;
  display: block;
  margin-bottom: 0.375rem;
  font-weight: 700;
  color: var(--color-slate-medium);
}

/* Checklist Box container */
.requirements {
  border-radius: var(--rounded-sm);
  background-color: var(--color-surface-low);
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 16px;
  font-size: 12px;
  color: var(--color-text-body);
}

/* Submit Button */
.btn-primary {
  width: 100%;
  padding: 0.875rem 1.5rem;
  border-radius: var(--rounded-xs);
  text-transform: capitalize;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  background: linear-gradient(
    135deg,
    var(--color-primary) 0%,
    var(--color-primary-container) 100%
  );
  color: var(--color-white);
  box-shadow: 0px 4px 6px -4px #003d9b33;
  transition: opacity 0.2s ease;
}
.btn-primary:hover {
  opacity: 0.9;
}
.btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Optional description texts */
.optional-text {
  font-size: 11px;
  color: var(--color-placeholder);
}

input::-ms-reveal,
input::-ms-clear {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

input::-webkit-contacts-auto-fill-button,
input::-webkit-credentials-auto-fill-button {
  visibility: hidden !important;
  display: none !important;
  pointer-events: none !important;
}

input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active {
  -webkit-box-shadow: 0 0 0 30px #ebf0ff inset !important;
  -webkit-text-fill-color: #1e293b !important; 
  transition: background-color 5000s ease-in-out 0s; 
}

:host {
  display: block;
  width: 100%;
  height: 100%;
  overflow-x: auto;
}
@media (max-width: 767.98px) {
  :root {
    --font-title: 1.25rem; /* 20px */
    --font-sm: 0.625rem;   /* 14px */
    --font-base: 1.25rem;  /* 20px */

  }
}
  @media (min-width: 768px) {
 .description-box {
  font-size: var(--font-base); /* 16px  */
  }

}